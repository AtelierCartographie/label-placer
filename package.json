{
  "name": "@ateliercartographie/label-placer",
  "version": "0.2.0",
  "description": "Render-agnostic automatic label placement for maps and charts: ordered candidate positions, priorities, obstacles, leader lines, pinned labels",
  "type": "module",
  "main": "./dist/label-placer.cjs",
  "module": "./dist/label-placer.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/label-placer.js",
      "require": "./dist/label-placer.cjs"
    },
    "./plot": {
      "types": "./dist/src/plot.d.ts",
      "import": "./dist/plot.js",
      "require": "./dist/plot.cjs"
    },
    "./mapshaper": {
      "types": "./dist/src/mapshaper.d.ts",
      "import": "./dist/mapshaper.js",
      "require": "./dist/mapshaper.cjs"
    },
    "./maplibre": {
      "types": "./dist/src/maplibre.d.ts",
      "import": "./dist/maplibre.js",
      "require": "./dist/maplibre.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite serve docs",
    "build": "tsc --noEmit && vite build && tsc --declaration --emitDeclarationOnly && node scripts/fix-dts-extensions.mjs",
    "build:docs": "node scripts/build-docs.ts",
    "test": "vitest run",
    "bench": "node bench/run.ts",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "prepare": "vite build && tsc --declaration --emitDeclarationOnly && node scripts/fix-dts-extensions.mjs",
    "prepublishOnly": "vitest run"
  },
  "keywords": [
    "label",
    "label-placement",
    "labeling",
    "leader-line",
    "callout",
    "collision",
    "cartography",
    "map",
    "dataviz",
    "observable-plot",
    "mapshaper",
    "maplibre"
  ],
  "author": "Atelier de cartographie de Sciences Po",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtelierCartographie/label-placer.git"
  },
  "homepage": "https://github.com/AtelierCartographie/label-placer#readme",
  "bugs": {
    "url": "https://github.com/AtelierCartographie/label-placer/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
